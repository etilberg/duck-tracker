# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# The GitHub username that gets admin access
ADMIN_GITHUB_USERNAME=your_github_username

# Resend email API key (https://resend.com - free tier: 3k emails/mo)
RESEND_API_KEY=re_your_api_key

# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://duck-tracker.pages.dev
